<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:WeatherApp"
        x:Class="WeatherApp.MainWindow"
        x:DataType="app:MainViewModel"
        Title="Avalonia Weather"
        Width="520" Height="460"
        MinWidth="400" MinHeight="400">

  <DockPanel Margin="20">

    <!-- Open-Meteo's free tier requires attribution. -->
    <TextBlock DockPanel.Dock="Bottom"
               Text="Weather data by Open-Meteo.com"
               FontSize="11" Opacity="0.7" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
      <ListBox ItemsSource="{Binding Cities}"
               SelectedItem="{Binding SelectedCity}"
               SelectionMode="AlwaysSelected"
               Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="app:City">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Column="1"
              Content="Refresh"
              VerticalAlignment="Top"
              Margin="8,0,0,0"
              Command="{Binding RefreshCommand}" />
    </Grid>

    <Panel Margin="0,16">

      <TextBlock Text="Loading…"
                 Opacity="0.7"
                 IsVisible="{Binding IsLoading}" />

      <StackPanel Spacing="4"
                  IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="Couldn't load the forecast" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="13" />
        <TextBlock Text="Select Refresh to try again." FontSize="13" Opacity="0.7" />
      </StackPanel>

      <StackPanel Spacing="4"
                  IsVisible="{Binding Forecast, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Forecast.Temperature}" FontSize="36" FontWeight="Bold" />
        <TextBlock Text="{Binding Forecast.Condition}" />
        <TextBlock Text="{Binding Forecast.Details}" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Forecast.Days}" Margin="0,12,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="app:DayRow">
              <Grid ColumnDefinitions="110,*,Auto" Margin="0,3">
                <TextBlock Text="{Binding Date}" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{Binding Condition}" FontSize="13" />
                <TextBlock Grid.Column="2" Text="{Binding Range}" FontSize="13" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </Panel>
  </DockPanel>
</Window>
